      "Bash(sed -i 's/export const APP_VERSION = \"1.32.74\";/export const APP_VERSION = \"1.32.75\";/' frontend/src/lib/version.ts)",
      "Bash(python3 -c \"import ast; ast.parse\\(open\\('backend/app/services/billing_service.py'\\).read\\(\\)\\); print\\('✅ syntax OK'\\)\")",
      "Bash(grep -rn \"subscriptions/\\\\${\\\\|PATCH.*subscription\\\\|plan:\\\\|modules\" \"frontend/src/app/admin/subscribers/[id]/page.tsx\")",
      "Bash(python3 -c \"import ast; ast.parse\\(open\\('backend/app/api/v1/routers/admin.py'\\).read\\(\\)\\); print\\('✅ syntax OK'\\)\")",
