# RxVision — Caddy reverse proxy
#
# Routing:
#   app.rxvision.gr         -> Next.js PWA (web:3000), /api/* -> FastAPI (api:8000)
#   adminpanel.rxvision.gr  -> same web, root rewritten to /admin, /api/* -> api
#
# TLS: controlled by {$CADDY_TLS} (default "internal" = self-signed origin cert).
#   - Works behind Cloudflare in "Full" SSL mode immediately.
#   - To get a publicly-trusted cert behind Cloudflare proxy AFTER you switch the
#     registrar nameservers to Cloudflare, set in .env:
#         CADDY_TLS=dns cloudflare {env.CF_API_TOKEN}
#     (this image is built with the caddy-dns/cloudflare plugin) and set CF_API_TOKEN.
{
	email admin@rxvision.gr

	# SECURITY (C-2): trusted proxies = the internal ingress + Cloudflare edge IPs. This makes
	# {client_ip} resolve to the REAL end-user (walking back the trusted CF→LB chain) and, crucially,
	# makes a client-supplied CF-Connecting-IP / X-Forwarded-For UNTRUSTED when the request does NOT come
	# through that chain — so an attacker hitting the origin directly can no longer spoof their IP to
	# rotate the rate-limit key. Keep the Cloudflare list in sync with https://www.cloudflare.com/ips/.
	# 10.0.0.4/32 = the internal ingress/LB fronting both app nodes (it forwards Cloudflare's sanitized
	# X-Forwarded-For). NB: 10.0.0.4's PUBLIC :443 must be firewalled to Cloudflare IPs only (C-1),
	# else an attacker could hit the LB directly and spoof XFF.
	servers {
		trusted_proxies static \
 10.0.0.4/32 \
 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 \
 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 \
 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 \
 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 \
 2a06:98c0::/29 2c0f:f248::/32
	}
}

# Security response headers (defense-in-depth; applied to every site below).
# NB: no Content-Security-Policy yet — Next.js inline hydration scripts need a nonce
# integration first; clickjacking is covered by X-Frame-Options DENY.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Lock down powerful browser features to only what the app uses (camera = barcode scanner,
		# geolocation = nearby-pharmacy, microphone = φωνητική εντολή σε Copilot/PharmaCat). CSP itself
		# is set per-request (with a nonce) by Next middleware.
		Permissions-Policy "camera=(self), geolocation=(self), microphone=(self), payment=(), usb=(), interest-cohort=()"
		-Server
	}
}

(api_and_app) {
	import security_headers
	# LOAD-BALANCER HEALTH PROBE — reflects REAL app readiness (proxied to the api /health endpoint),
	# so a node whose caddy is up but whose app isn't ready/serving is marked UNHEALTHY and pulled from
	# rotation. Reachable ONLY from the internal network (Hetzner LB private IP, 10.0.0.0/16) → it is
	# exempt from the origin-auth guard below (the LB can't inject the Cloudflare secret), while a public
	# hit on the open LB IP still falls through to the 403. This replaces the old TCP-443 health check,
	# whose false-positives (caddy binds :443 before the app is ready) broke failover during a
	# node reboot/redeploy — the LB kept routing ~50% of traffic to the not-yet-ready node.
	@lbhealth {
		path /lb-health
		remote_ip 10.0.0.0/16
	}
	handle @lbhealth {
		# → web /healthz, which returns 200 only when the web server is up AND it can reach the api.
		# So the node is "healthy" only when it can truly serve (web + api), not just when caddy is up.
		rewrite * /healthz
		reverse_proxy web:3000
	}
	# ORIGIN AUTH (C-1): reject any request that does NOT bear Cloudflare's injected X-Origin-Auth secret
	# (set by a Cloudflare Transform Rule; value from .env ORIGIN_AUTH_SECRET). Cloudflare-fronted traffic
	# always carries it (verified 100%); a direct hit to the open LB (65.109.43.125) does not → 403. This
	# closes the load-balancer bypass at the HTTP layer (mTLS wasn't relayed by the TCP LB). ROLLBACK:
	# remove this matcher+handle (backup: backups/vault-snapshot/Caddyfile.pre-mtls-rollback).
	@noauth not header X-Origin-Auth {$ORIGIN_AUTH_SECRET}
	handle @noauth {
		respond "Forbidden" 403 {
			close
		}
	}
	# API first (same-origin -> no CORS), everything else to the web app.
	# X-Real-Client-IP is set from Caddy's TRUSTED-PROXY-verified client IP and OVERWRITES any inbound
	# value → the backend rate-limiter/audit read a non-spoofable client IP (C-2).
	handle /api/* {
		# H-4: cap request bodies so an unbounded upload can't exhaust memory on the shared host.
		# 30MB covers the largest app-level upload cap (catalog XML / GESY = 25MB) with margin; the
		# per-endpoint caps in FastAPI still enforce the real (8–25MB) limits.
		request_body {
			max_size 30MB
		}
		reverse_proxy api:8000 {
			header_up X-Real-Client-IP {client_ip}
			# API απαντήσεις ΠΟΤΕ cached (browser/CDN) — αλλιώς stale PII (π.χ. demo masking «δεν
			# δούλευε» επειδή ο browser σέρβιρε παλιά /renewals). Auth-scoped → private.
			header_down Cache-Control "no-store, no-cache, must-revalidate, private"
		}
	}
	handle /health {
		reverse_proxy api:8000 {
			header_up X-Real-Client-IP {client_ip}
		}
	}
	# Immutable hashed assets — keep Next.js' long-lived cache.
	handle /_next/* {
		reverse_proxy web:3000
	}
	# Service worker must never be cached (so the kill-switch/updates always land).
	handle /sw.js {
		reverse_proxy web:3000 {
			header_down >Cache-Control "no-cache, no-store, must-revalidate"
		}
	}
	# Everything else (HTML documents) — strip the origin's s-maxage (which let Cloudflare
	# cache HTML for a year) and force revalidation, so a redeploy is picked up immediately.
	handle {
		request_body {
			max_size 8MB
		}
		reverse_proxy web:3000 {
			header_down >Cache-Control "no-cache, must-revalidate"
		}
	}
}

app.rxvision.gr {
	tls {$CADDY_TLS:internal}
	import api_and_app
}

adminpanel.rxvision.gr {
	tls {$CADDY_TLS:internal}
	# Land the back-office on /admin by default.
	@root path /
	rewrite @root /admin
	import api_and_app
}

my.rxvision.gr {
	tls {$CADDY_TLS:internal}
	# Patient portal (3rd identity). Land on /portal by default; same web + /api backend.
	@root path /
	rewrite @root /portal
	import api_and_app
}

# SECURITY (C-1): the plaintext-HTTP preview site on the raw origin IP has been REMOVED. Serving the app
# over http:// on 157.180.26.98 bypassed Cloudflare's TLS/WAF and exposed bearer tokens in cleartext.
# The app is reachable ONLY through the Cloudflare-fronted domains below. For local/off-Cloudflare access
# use an SSH tunnel to :443 with the domain Host header, not a public plaintext IP endpoint.
# (Complete C-1 with a host firewall allowing 80/443 only from Cloudflare IP ranges.)
